---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import {
  PARTNER_NAME,
  PARTNER_TEXT,
  PARTNER_AVITO_URL,
  PARTNER_REGION,
  PARTNER_LABEL
} from '../config/partner';

const breadcrumbs = [
  { name: 'Строительный партнёр', item: '/partner/' }
];
---

<BaseLayout
  title={`${PARTNER_NAME} — Строительство и ремонт`}
  description="Строительный партнёр проекта СтройРасчёт: профессиональный монтаж фундаментов, кладка стен, кровельные работы и чистовая отделка коттеджей."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-4 mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs uppercase font-bold tracking-wider px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">
          Официальный строительный партнёр
        </span>
        {PARTNER_LABEL && (
          <span class="text-xs text-slate-500 uppercase tracking-wider">
            {PARTNER_LABEL}
          </span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
        {PARTNER_NAME}
      </h1>
      <p class="text-base text-slate-300 leading-relaxed max-w-2xl">
        Проверенный специалист по капитальному загородному строительству, бетонным работам и внутренней отделке.
      </p>
    </header>

    <div class="space-y-8">
      <!-- Main Partner Info Card -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-amber-500/20 bg-gradient-to-br from-amber-950/20 via-slate-900/60 to-cyan-950/20 space-y-6">
        <div>
          <h2 class="text-xl font-bold text-white mb-2">О мастере и бригаде</h2>
          <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
            {PARTNER_TEXT}
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-white/10 text-sm">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
              ✓
            </div>
            <span class="text-slate-200">Работа по договору с гарантией</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
              ✓
            </div>
            <span class="text-slate-200">Фиксированная прозрачная смета</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
              ✓
            </div>
            <span class="text-slate-200">Собственный парк оборудования</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
              ✓
            </div>
            <span class="text-slate-200">Регион: {PARTNER_REGION}</span>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
          <a
            href={PARTNER_AVITO_URL}
            target="_blank"
            rel="sponsored noopener noreferrer"
            class="btn-primary w-full sm:w-auto text-sm"
          >
            <span>Посмотреть профиль и отзывы на Авито</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
          <span class="text-xs text-slate-400">
            Прямая ссылка на проверенный профиль мастера
          </span>
        </div>
      </div>

      <!-- Services List -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/5 space-y-4">
        <h2 class="text-lg font-bold text-white">Выполняемые виды работ</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs sm:text-sm">
          <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-slate-200">
            • Монтаж ленточных, плитных и свайно-ростверковых фундаментов
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-slate-200">
            • Кладка газобетонных блоков, кирпича, керамоблоков
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-slate-200">
            • Строительство двускатных и вальмовых крыш, монтаж черепицы
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-slate-200">
            • Полусухая и мокрая стяжка пола, гидроизоляция
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-slate-200">
            • Механизированная штукатурка и шпаклевка под маяк
          </div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-slate-200">
            • Укладка крупноформатного керамогранита и плитки
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
