---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { ArmaturaCalculator } from '../../components/calculators/ArmaturaCalculator';
import { NORMATIVE_REGISTRY } from '../../data/norms';

const normData = NORMATIVE_REGISTRY['kalkulyator-armatury'];

const faq = [
  {
    question: 'Какой минимальный процент армирования фундамента требует СП 63.13330?',
    answer: 'Согласно пункту 10.3.6 СП 63.13330.2018 площадь сечения продольной рабочей арматуры в железобетонном элементе должна составлять не менее 0.10% от площади расчетного сечения бетона. Например, для ленты сечением 400×800 мм общая площадь бетона составляет 320 000 мм², соответственно суммарная площадь сечения стержней должна быть не менее 320 мм² (что перекрывается 4 стержнями диаметром 12 мм общей площадью 452 мм²).'
  },
  {
    question: 'Какой диаметр арматуры выбрать для ленточного фундамента?',
    answer: 'При длине стороны фундамента до 3 метров допускается применение рабочей арматуры диаметром 10 мм. При длине стен более 3 метров строительные нормы предписывают использовать рифленую арматуру класса А500С диаметром не менее 12 мм. Для тяжелых кирпичных стен и слабонесущих грунтов сечение увеличивают до 14–16 мм.'
  },
  {
    question: 'Какой нахлёст стержней по длине необходим при стыковке?',
    answer: 'При стыковке арматурных стержней без сварки (вязка внахлёст) длина перепуска стержней класса А500С в растянутой зоне бетона класса В20–В25 должна составлять не менее 50 диаметров арматуры (50d). Для стержня ⌀12 мм нахлёст равен 600 мм, для ⌀14 мм — 700 мм, для ⌀16 мм — 800 мм.'
  },
  {
    question: 'Как правильно армировать углы фундамента?',
    answer: 'Простое перекрестие стержней в углах категорически запрещено строительными нормами, так как угол фундамента работает на разрыв. Углы обязательно анкеруются специальными Г-образными или П-образными элементами из того же диаметра арматуры с длиной лапы анкеровки не менее 50d.'
  },
  {
    question: 'Зачем нужны пластиковые фиксаторы и почему нельзя класть арматуру на грунт или кирпич?',
    answer: 'Рабочая арматура должна быть со всех сторон защищена слоем бетона толщиной не менее 35–50 мм (СП 63.13330 п. 10.3.2). Это предотвращает коррозию стали и обеспечивает проектное сцепление металла со смесью. Использование битого кирпича или деревянных брусков недопустимо, так как они впитывают влагу и вызывают локальное разрушение бетона.'
  },
  {
    question: 'Что входит в расчёт «Режима мастера»?',
    answer: '«Режим мастера» формирует смету монтажных работ по ЕНиР: вязку пространственного арматурного каркаса, монтаж/раскрепление щитовой опалубки и приёмку бетонной смеси с вибрированием. Вы можете изменить ставки под региональные тарифы вашей бригады и распечатать готовую смету в PDF.'
  }
];

const related = [
  { href: '/kalkulyatory/kalkulyator-betona/', title: 'Калькулятор бетона для фундамента', norm: 'ГОСТ 7473-2010' },
  { href: '/kalkulyatory/kalkulyator-glubiny-promerzaniya/', title: 'Калькулятор глубины промерзания', norm: 'СП 22.13330.2016' },
  { href: '/kalkulyatory/kalkulyator-pilomaterialov/', title: 'Калькулятор доски для опалубки', norm: 'ГОСТ 8486-86' },
  { href: '/kalkulyatory/kalkulyator-kirpicha/', title: 'Калькулятор кирпичной кладки', norm: 'ГОСТ 530-2012' },
  { href: '/kalkulyatory/kalkulyator-gazobetona/', title: 'Калькулятор газобетона для стен', norm: 'ГОСТ 31360-2007' }
];
---

<CalculatorLayout
  calculatorId="kalkulyator-armatury"
  h1="Калькулятор арматуры для фундамента онлайн"
  title="Калькулятор арматуры для фундамента онлайн — расчёт по СП 63.13330.2018"
  description="Онлайн-расчёт арматуры для фундамента по СП 63.13330.2018 и ГОСТ 5781-82. Векторная схема сечения, расчёт хлыстов, хомутов и сметы работ мастера."
  lead="Инженерный калькулятор вычисляет погонаж, вес и количество стержней рабочей арматуры А500С, хомутов, проволоки и фиксаторов по нормам СП 63.13330.2018 с проверкой минимального процента армирования и расчётом сметы работ мастера."
  tldr="На стандартную ленту 10×10 м сечением 0,4×0,8 м при 4 стержнях ⌀12 мм требуется ~200 м рабочей арматуры (~178 кг), ~120 хомутов ⌀8 мм (~110 кг), 3,5 кг вязальной проволоки и 160 фиксаторов. Общий вес стали — ~0,32 тн."
  updatedAt="2026-11-02"
  norms={normData.normativeBasis}
  faq={faq}
  relatedCalculators={related}
>
  <div slot="calculator">
    <ArmaturaCalculator client:load />
  </div>

  <div slot="expert-content" class="space-y-6 text-slate-300">
    <h2 class="text-2xl font-bold text-white tracking-tight">
      Методика инженерного расчёта армирования фундамента
    </h2>

    <p class="leading-relaxed">
      Бетон обладает колоссальной прочностью на сжатие, однако его прочность на растяжение и изгиб в 10–15 раз ниже. Задача стального арматурного каркаса — воспринять растягивающие нагрузки, возникающие при морозном пучении грунта, неравномерной осадке основания и воздействии массы здания.
    </p>

    <h3 class="text-xl font-bold text-white tracking-tight mt-6">
      1. Нормативные требования СП 63.13330.2018 (СНиП 52-01-2003)
    </h3>
    <ul class="list-disc pl-6 space-y-2">
      <li>
        <strong>Минимальный процент армирования ($\mu$):</strong> согласно п. 10.3.6 СП 63.13330, в ленточных и плитных фундаментах отношение суммарной площади сечения продольной арматуры к площади рабочего сечения бетона должно быть не менее:
        <div class="p-3 my-2 bg-slate-800/80 rounded-xl font-mono text-amber-300 text-sm border border-slate-700">
          μ = (A_s / A_b) × 100% ≥ 0.10%
        </div>
      </li>
      <li>
        <strong>Число продольных стержней:</strong> при высоте ленты h ≤ 800 мм достаточно двух поясов армирования (верхний и нижний, всего 4 стержня). При высоте h &gt; 800 мм необходимо устраивать дополнительный средний конструктивный пояс (суммарно не менее 6 стержней) во избежание выпучивания боковых граней.
      </li>
      <li>
        <strong>Шаг поперечных хомутов ($s$):</strong> хомуты связывают каркас в единый пространственный короб и воспринимают поперечные срезающие усилия. Шаг хомутов по СП принимается:
        <div class="p-3 my-2 bg-slate-800/80 rounded-xl font-mono text-cyan-300 text-sm border border-slate-700">
          s ≤ 0.75 · h  и  s ≤ 500 мм (в зоне анкеровок и углов: s ≤ 0.5 · h)
        </div>
      </li>
      <li>
        <strong>Длина нахлёста стержней (L_overlap):</strong> стыковка хлыстов по длине выполняется с перепуском:
        <div class="p-3 my-2 bg-slate-800/80 rounded-xl font-mono text-emerald-300 text-sm border border-slate-700">
          L_overlap = 50 · d  (для d12 = 600 мм; для d14 = 700 мм; для d16 = 800 мм)
        </div>
      </li>
    </ul>

    <h3 class="text-xl font-bold text-white tracking-tight mt-6">
      2. Вес погонного метра арматуры по ГОСТ 5781-82 и ГОСТ 34028-2016
    </h3>
    <div class="overflow-x-auto rounded-2xl border border-slate-700">
      <table class="w-full text-xs text-left">
        <thead class="bg-slate-800 text-slate-300 font-bold border-b border-slate-700 uppercase">
          <tr>
            <th class="p-3">Номинальный диаметр (d, мм)</th>
            <th class="p-3">Площадь сечения (см²)</th>
            <th class="p-3">Масса 1 пог. м (кг)</th>
            <th class="p-3">Класс стали</th>
            <th class="p-3">Основное применение</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <tr>
            <td class="p-3 font-mono font-bold text-amber-400">6 мм</td>
            <td class="p-3 font-mono">0.283</td>
            <td class="p-3 font-mono">0.222 кг</td>
            <td class="p-3">А240 (гладкая)</td>
            <td class="p-3 text-slate-400">Поперечные хомуты лёгких лент</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-amber-400">8 мм</td>
            <td class="p-3 font-mono">0.503</td>
            <td class="p-3 font-mono">0.395 кг</td>
            <td class="p-3">А240 / А500С</td>
            <td class="p-3 text-slate-400">Хомуты лент, поддерживающие лягушки плит</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-amber-400">10 мм</td>
            <td class="p-3 font-mono">0.785</td>
            <td class="p-3 font-mono">0.617 кг</td>
            <td class="p-3">А500С (рифленая)</td>
            <td class="p-3 text-slate-400">Рабочая сетка плит, ленты длиной до 3 м</td>
          </tr>
          <tr class="bg-amber-500/10">
            <td class="p-3 font-mono font-bold text-amber-300">12 мм (Стандарт)</td>
            <td class="p-3 font-mono font-bold text-amber-300">1.131</td>
            <td class="p-3 font-mono font-bold text-amber-300">0.888 кг</td>
            <td class="p-3 font-bold text-amber-300">А500С (рифленая)</td>
            <td class="p-3 font-bold text-amber-300">Базовый стандарт частного домостроения</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-amber-400">14 мм</td>
            <td class="p-3 font-mono">1.539</td>
            <td class="p-3 font-mono">1.210 кг</td>
            <td class="p-3">А500С (рифленая)</td>
            <td class="p-3 text-slate-400">Ленты и плиты под двухэтажные дома из кирпича</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold text-amber-400">16 мм</td>
            <td class="p-3 font-mono">2.011</td>
            <td class="p-3 font-mono">1.580 кг</td>
            <td class="p-3">А500С (рифленая)</td>
            <td class="p-3 text-slate-400">Фундаменты на плывунах и тяжёлые перекрытия</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-xl font-bold text-white tracking-tight mt-6">
      3. «Режим мастера»: Расчёт трудозатрат и составление сметы
    </h3>
    <p class="leading-relaxed">
      Для прорабов, бригадиров и частных заказчиков наш калькулятор автоматически рассчитывает сметную стоимость работ по нормативам ЕНиР:
    </p>
    <ul class="list-disc pl-6 space-y-1.5 text-sm">
      <li><strong>Вязка арматурного каркаса:</strong> тарифицируется за 1 тонну смонтированной стали (в среднем 25 000–35 000 руб./тн) либо за погонный метр ленты.</li>
      <li><strong>Установка и раскрепление щитовой опалубки:</strong> расчёт по площади контакта бетона с опалубкой (в среднем 600–900 руб./м²).</li>
      <li><strong>Приёмка и вибрирование бетона:</strong> укладка смеси глубинным вибратором (в среднем 4 500–6 000 руб./м³ при ручной приёмке или заливке бетононасосом).</li>
    </ul>
  </div>
</CalculatorLayout>
