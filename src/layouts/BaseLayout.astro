---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/seo/BaseHead.astro';
import JsonLd, { type BreadcrumbItem, type FaqItem, type WebAppInfo } from '../components/seo/JsonLd.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import CookieBanner from '../components/privacy/CookieBanner.astro';
import ThemeSwitcher from '../components/common/ThemeSwitcher.astro';
import AtmosphereBackground from '../components/common/AtmosphereBackground.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  breadcrumbs?: BreadcrumbItem[];
  faq?: FaqItem[];
  webApp?: WebAppInfo;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  breadcrumbs,
  faq,
  webApp,
  publishedTime,
  modifiedTime
} = Astro.props;
---

<!doctype html>
<html lang="ru" data-theme="neon">
  <head>
    <meta charset="utf-8" />
    <!-- Instant theme initialization to eliminate flash of unstyled theme -->
    <script is:inline>
      (function() {
        try {
          var params = new URLSearchParams(window.location.search);
          var themeUrl = params.get('theme');
          var validThemes = ['neon', 'warm', 'forest', 'sunset', 'light'];
          var theme = 'neon';
          if (themeUrl && validThemes.indexOf(themeUrl) !== -1) {
            theme = themeUrl;
            localStorage.setItem('stroycalc_theme', theme);
          } else {
            var stored = localStorage.getItem('stroycalc_theme');
            if (stored && validThemes.indexOf(stored) !== -1) {
              theme = stored;
            }
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch(e) {}
      })();
    </script>

    <ClientRouter />

    <BaseHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <JsonLd
      breadcrumbs={breadcrumbs}
      faq={faq}
      webApp={webApp}
    />
  </head>
  <body class="bg-[var(--bg)] text-[var(--text)] min-h-[100svh] flex flex-col selection:bg-[var(--glow)] selection:text-[var(--text)] transition-colors duration-300 relative max-w-full overflow-x-hidden">
    <!-- Persistent Unified 3D WebGL Scene Root (Astro transition:persist preserves canvas and WebGL context across page navigations) -->
    <div
      id="scene-root"
      transition:persist
      aria-hidden="true"
      class="fixed inset-0 w-full h-full pointer-events-none z-0 overflow-hidden"
    ></div>

    <!-- Soft static background blueprint atmosphere (used as fallback on weak devices or prefers-reduced-motion) -->
    <AtmosphereBackground />

    <!-- Skip to content for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--accent)] focus:text-[var(--btn-text)] focus:font-semibold focus:rounded-lg focus:shadow-lg"
    >
      Перейти к основному содержимому
    </a>

    <!-- Top Navigation Header -->
    <Header />

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 flex flex-col min-w-0 w-full relative z-10 page-transition-enter overflow-x-hidden">
      <slot />
    </main>

    <!-- Bottom Footer -->
    <Footer />

    <!-- Theme Switcher Widget -->
    <ThemeSwitcher />

    <!-- Privacy & Cookie Banner -->
    <CookieBanner />

    <!-- Global Persistent Scene & Transition Controller -->
    <script>
      import { initGlobalScene, onPageLoadNav, startSceneTransition } from '../components/HouseOrb';

      // Initialize persistent scene once on initial load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initGlobalScene());
      } else {
        initGlobalScene();
      }

      // Astro ClientRouter page load hook
      document.addEventListener('astro:page-load', () => {
        onPageLoadNav(window.location.pathname);
      });

      // Immediate transition on link click (starts in <= 16ms, parallel to Astro navigation)
      document.addEventListener('click', (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        const a = (e.target as HTMLElement)?.closest('a');
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || a.target === '_blank' || a.hasAttribute('download')) return;

        const clean = href.split('?')[0].split('#')[0];
        const isTargetHome = clean === '/' || clean === '/index.html' || clean === '';
        const isCurrentHome = window.location.pathname === '/' || window.location.pathname === '/index.html' || window.location.pathname === '';

        const clickTime = performance.now();
        if (isCurrentHome && !isTargetHome) {
          startSceneTransition('ambient', clickTime);
        } else if (!isCurrentHome && isTargetHome) {
          startSceneTransition('house', clickTime);
        }
      }, { capture: true });
    </script>
  </body>
</html>
