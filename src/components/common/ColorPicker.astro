---
import { HOUSE_COLOR_DEFAULT, SHOW_COLOR_PICKER } from '../../config/site';

if (!SHOW_COLOR_PICKER) {
  return null;
}

const presets = [
  { name: 'Янтарь', hex: '#f59e0b' },
  { name: 'Циан', hex: '#06b6d4' },
  { name: 'Изумруд', hex: '#10b981' },
  { name: 'Фиолетовый', hex: '#8b5cf6' },
  { name: 'Розовый', hex: '#ec4899' },
  { name: 'Красный', hex: '#ef4444' },
  { name: 'Золотой', hex: '#eab308' },
  { name: 'Серебро', hex: '#e2e8f0' },
];
---

<div
  id="color-picker-widget"
  class="fixed bottom-6 right-6 z-30 flex flex-col items-end"
  role="region"
  aria-label="Настройка оттенка 3D-дома"
>
  <!-- Expandable Panel -->
  <div
    id="color-picker-panel"
    class="hidden mb-3 p-4 rounded-2xl glass-card border border-white/10 shadow-2xl bg-[#070b16]/95 backdrop-blur-xl w-64 space-y-3 transition-all duration-300"
  >
    <div class="flex items-center justify-between border-b border-white/10 pb-2">
      <span class="text-xs font-semibold text-white tracking-wide">Оттенок 3D-дома</span>
      <span class="text-[10px] text-amber-400 font-mono" id="current-hex-display">
        {HOUSE_COLOR_DEFAULT}
      </span>
    </div>

    <!-- Presets 4x2 grid -->
    <div class="grid grid-cols-4 gap-2">
      {presets.map((preset) => (
        <button
          type="button"
          data-color={preset.hex}
          class="color-preset-btn w-10 h-10 rounded-xl border border-white/20 transition-transform hover:scale-110 active:scale-95 flex items-center justify-center min-w-[40px] min-h-[40px]"
          style={`background-color: ${preset.hex}`}
          title={preset.name}
          aria-label={`Выбрать цвет ${preset.name}`}
        />
      ))}
    </div>

    <!-- Custom Color & Copy Link -->
    <div class="pt-2 border-t border-white/10 flex items-center justify-between gap-2">
      <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-300 hover:text-white">
        <input
          type="color"
          id="custom-color-input"
          value={HOUSE_COLOR_DEFAULT}
          class="w-7 h-7 rounded-lg border-0 bg-transparent cursor-pointer"
        />
        <span>Свой цвет</span>
      </label>

      <button
        type="button"
        id="copy-color-link-btn"
        class="text-[11px] text-cyan-400 hover:text-cyan-300 font-medium px-2 py-1 rounded bg-cyan-500/10 border border-cyan-500/20"
        title="Скопировать ссылку с текущим цветом для отправки"
      >
        Ссылка брату
      </button>
    </div>
  </div>

  <!-- Main Floating Toggle Button (>= 44px) -->
  <button
    id="color-picker-toggle"
    type="button"
    class="min-w-[48px] min-h-[48px] p-3 rounded-2xl glass-card border border-amber-500/30 text-amber-400 shadow-xl hover:border-amber-400 hover:scale-105 active:scale-95 transition-all flex items-center justify-center bg-[#090e1a]/90 focus:outline-none focus:ring-2 focus:ring-amber-500"
    aria-label="Открыть панель выбора цвета дома"
    aria-expanded="false"
  >
    <div
      id="color-indicator-dot"
      class="w-5 h-5 rounded-full transition-colors shadow-sm"
      style={`background-color: ${HOUSE_COLOR_DEFAULT}`}
    />
  </button>
</div>

<script define:vars={{ defaultColor: HOUSE_COLOR_DEFAULT }}>
  const widget = document.getElementById('color-picker-widget');
  const toggleBtn = document.getElementById('color-picker-toggle');
  const panel = document.getElementById('color-picker-panel');
  const indicator = document.getElementById('color-indicator-dot');
  const hexDisplay = document.getElementById('current-hex-display');
  const customInput = document.getElementById('custom-color-input');
  const copyLinkBtn = document.getElementById('copy-color-link-btn');

  // Check URL param ?color=... first, then localStorage, then default
  function getActiveColor() {
    const params = new URLSearchParams(window.location.search);
    const urlColor = params.get('color');
    if (urlColor && /^([0-9A-Fa-f]{6})$/.test(urlColor)) {
      return `#${urlColor}`;
    }
    return localStorage.getItem('houseColor') || defaultColor;
  }

  function applyColor(hex) {
    if (indicator) indicator.style.backgroundColor = hex;
    if (hexDisplay) hexDisplay.textContent = hex;
    if (customInput) customInput.value = hex;
    localStorage.setItem('houseColor', hex);

    // Notify HouseOrb instance via custom event
    window.dispatchEvent(new CustomEvent('house-color-change', { detail: { color: hex } }));
  }

  const initialColor = getActiveColor();
  applyColor(initialColor);

  if (toggleBtn && panel) {
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      toggleBtn.setAttribute('aria-expanded', String(isHidden));
    });

    document.addEventListener('click', (e) => {
      if (widget && !widget.contains(e.target)) {
        panel.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Presets
  document.querySelectorAll('.color-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const color = btn.getAttribute('data-color');
      if (color) applyColor(color);
    });
  });

  // Custom Color
  if (customInput) {
    customInput.addEventListener('input', (e) => {
      applyColor(e.target.value);
    });
  }

  // Copy link with color for brother
  if (copyLinkBtn) {
    copyLinkBtn.addEventListener('click', () => {
      const active = localStorage.getItem('houseColor') || defaultColor;
      const cleanHex = active.replace('#', '');
      const url = `${window.location.origin}${window.location.pathname}?color=${cleanHex}`;
      navigator.clipboard.writeText(url).then(() => {
        const oldText = copyLinkBtn.textContent;
        copyLinkBtn.textContent = 'Скопировано!';
        setTimeout(() => {
          copyLinkBtn.textContent = oldText;
        }, 2000);
      });
    });
  }
</script>
