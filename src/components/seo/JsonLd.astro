---
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION } from '../../config/site';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface FaqItem {
  question: string;
  answer: string;
}

export interface WebAppInfo {
  name: string;
  description: string;
  applicationCategory?: string;
  operatingSystem?: string;
}

export interface Props {
  breadcrumbs?: BreadcrumbItem[];
  faq?: FaqItem[];
  webApp?: WebAppInfo;
}

const { breadcrumbs, webApp } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// 1. WebSite schema (только на главной странице)
const websiteSchema = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: `${SITE_URL}/`,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  inLanguage: 'ru-RU',
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: `${SITE_URL}/`
  }
} : null;

// 2. Organization schema (только на главной странице)
const organizationSchema = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/favicon.svg`
} : null;

// 3. Breadcrumbs schema (только на внутренних страницах)
const breadcrumbsSchema = (!isHome && breadcrumbs && breadcrumbs.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.item.startsWith('http') ? crumb.item : `${SITE_URL}${crumb.item}`
  }))
} : null;

// 4. WebApplication schema (для интерактивных инженерных калькуляторов)
const webAppSchema = webApp ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: webApp.name,
  description: webApp.description,
  applicationCategory: webApp.applicationCategory || 'UtilitiesApplication',
  operatingSystem: webApp.operatingSystem || 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'RUB'
  }
} : null;
---

{isHome && websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
{isHome && organizationSchema && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
{!isHome && breadcrumbsSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />}
{webAppSchema && <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />}
