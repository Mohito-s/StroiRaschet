# ==============================================================================
# Эталонный Nginx конфиг для раздачи статического сайта StroiCalc (Astro SSG)
# Размещение на VPS: /etc/nginx/sites-available/stroyraschet.ru.conf
# ==============================================================================

# 1. Редирект HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name stroyraschet.ru www.stroyraschet.ru;

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://stroyraschet.ru$request_uri;
    }
}

# 2. Редирект HTTPS www -> без www
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.stroyraschet.ru;

    ssl_certificate /etc/letsencrypt/live/stroyraschet.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stroyraschet.ru/privkey.pem;

    return 301 https://stroyraschet.ru$request_uri;
}

# 3. Основной продуктовый сервер HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stroyraschet.ru;

    root /var/www/stroyraschet.ru/dist;
    index index.html;

    # SSL сертификаты (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/stroyraschet.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stroyraschet.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Сжатие Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml font/woff2;

    # Сжатие Brotli (если модуль ngx_brotli скомпилирован в nginx)
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml font/woff2;

    # Безопасность и заголовки
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Отключение автоматической блокировки ИИ-краулеров (Раздел 15)
    # Позволяет индексацию GPTBot, PerplexityBot, ClaudeBot, Yandex, Google

    # Хэшированная статика Astro (_astro/): кэш 1 год immutable
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Статические ассеты (картинки, шрифты, favicon)
    location ~* \.(ico|svg|png|jpg|jpeg|webp|avif|woff|woff2|ttf)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # robots.txt, sitemap.xml, llms.txt
    location ~* \.(txt|xml)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # HTML страницы (Astro SSG): trailing slash нормализация и fallback на 404
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # Кастомная страница 404
    error_page 404 /404/index.html;
}
